{
  "name": "lesson-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5196 --strictPort",
    "build": "tsc --noEmit && npm run check:content && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5197",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run check:content",
    "test:e2e": "node scripts/verify.mjs",
    "capture": "node scripts/verify.mjs --capture",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test src/domain/*.test.ts",
    "check:content": "node scripts/check-content.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
